{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeskFlow",
  "version": "1.0.0",
  "identifier": "app.deskflow.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskFlow",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Angel Taipe",
    "copyright": "© 2026 Angel Taipe",
    "category": "Utility",
    "shortDescription": "Organizador inteligente de archivos, local-first",
    "longDescription": "DeskFlow analiza una carpeta, propone una estructura según tus carpetas y no mueve nada sin tu confirmación. Nunca borra ni sobrescribe, y todo se puede deshacer.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
